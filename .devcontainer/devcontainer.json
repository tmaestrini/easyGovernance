// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/powershell
{
  "name": "easyGovernance",
  "dockerFile": "Dockerfile",
  
  // Keeps container running for interactive use
  "overrideCommand": false,
  
  // Run on every container start to keep it alive
  "postStartCommand": "echo 'easyGovernance container started' > /tmp/container-ready",
  
  // Initial setup message
  "postCreateCommand": "pwsh -Command 'Write-Host \"Welcome to easyGovernance -- you are connected remotely!\" -ForegroundColor Green'",
  
  // Mount your workspace with read/write access
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",
  
  // Keep stdin open for interactive sessions
  "runArgs": [
    "--network=host",
    "-i",  // Keep STDIN open
    "-t"   // Allocate pseudo-TTY
  ],
  
  "customizations": {
    "vscode": {
      "settings": { 
        "terminal.integrated.defaultProfile.linux": "pwsh",
        // Start terminal automatically
        "terminal.integrated.automationProfile.linux": {
          "path": "pwsh"
        },
        // Keep remote connection alive longer
        "remote.autoForwardPorts": false,
        "remote.restoreForwardedPorts": true
      },
      "extensions": [
        "ms-vscode.powershell"
      ]
    }
  },
  
  // Prevent container from stopping due to inactivity
  "shutdownAction": "none",
  
  // Keep connection alive - sends keepalive packets every 60 seconds
  "remoteEnv": {
    "REMOTE_CONTAINERS": "true"
  },
  
  // Feature to keep container running
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "installOhMyZsh": false
    }
  }
}